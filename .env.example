# Neon pooled connection string (injected by the Vercel Neon integration)
DATABASE_URL=
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/vercel_news_test

# Models route through the Vercel AI Gateway ("provider/model" slugs).
# Auth is the project's OIDC token (VERCEL_OIDC_TOKEN, refreshed via
# `vercel env pull`) — or set AI_GATEWAY_API_KEY for non-Vercel environments.
TEXT_MODEL=deepseek/deepseek-v4-flash
IMAGE_MODEL=google/gemini-3.1-flash-image

CRON_SECRET=
REVIEW_PASSWORD=
BLOB_READ_WRITE_TOKEN=
FAKE_LLM=0
TICK_BUDGET_MS=240000
