# Neon pooled connection string (injected by the Vercel Neon integration)
DATABASE_URL=
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/vercel_news_test

# Models route through the Vercel AI Gateway ("provider/model" slugs).
# Auth is the project's OIDC token (VERCEL_OIDC_TOKEN, refreshed via
# `vercel env pull`) — or set AI_GATEWAY_API_KEY for non-Vercel environments.
TEXT_MODEL=deepseek/deepseek-v4-flash
IMAGE_MODEL=recraft/recraft-v4.1
EMBEDDING_MODEL=openai/text-embedding-3-small
SPEECH_MODEL=openai/tts-1
SPEECH_VOICE=alloy

CRON_SECRET=
REVIEW_PASSWORD=
# Independent HMAC key for review sessions and privacy-preserving rate limits.
# Generate at least 32 random bytes; rotating it revokes all review sessions.
APP_SECRET=
# Hard ceiling for public semantic-search requests across all clients. Cached
# repeat queries still count, so paid embedding calls are at most this number.
SEARCH_EMBEDDING_LIMIT_PER_HOUR=100

# Review-ready email notifications (optional — skipped when unset).
# RESEND_API_KEY + REVIEW_NOTIFY_EMAIL enable them; REVIEW_NOTIFY_FROM must be
# a Resend-verified sender (defaults to onboarding@resend.dev). APP_URL is
# used to build the review link (falls back to the Vercel production URL).
RESEND_API_KEY=
REVIEW_NOTIFY_EMAIL=
REVIEW_NOTIFY_FROM=
APP_URL=
BLOB_READ_WRITE_TOKEN=
FAKE_LLM=0
TICK_BUDGET_MS=240000
AUDIO_JOBS_PER_TICK=1

# Weekly two-speaker review. The Vercel app prepares the script; a scheduled
# GitHub runner calls ElevenLabs, assembles the MP3, and uploads it to Blob.
# Keep the API key in .env.local / GitHub Actions secrets, never in this file.
ELEVENLABS_API_KEY=
WEEKLY_HOST_VOICE_ID=
WEEKLY_ANALYST_VOICE_ID=
WEEKLY_SPEECH_MODEL=eleven_v3
WEEKLY_MAX_SOURCE_ARTICLES=12

# Weekly newsletter. The GitHub Action uses the existing Resend provider with
# a dedicated sender path. NEWSLETTER_FROM and NEWSLETTER_RECIPIENTS override
# the review-notification settings; when omitted, they fall back to
# REVIEW_NOTIFY_FROM / REVIEW_NOTIFY_EMAIL respectively.
NEWSLETTER_FROM=
NEWSLETTER_RECIPIENTS=
NEWSLETTER_REPLY_TO=
NEWSLETTER_WEEK_ENDING=
NEWSLETTER_DRY_RUN=false
NEWSLETTER_MAX_ARTICLES=20
NEWSLETTER_OUTPUT_DIR=newsletter-previews
